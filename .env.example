# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# There are no default passwords. Compose fails fast with a named variable if one is
# missing, which is preferable to a stack that silently comes up with a known
# credential and then gets port-forwarded somewhere it should not be.
#
# Generate values with:  openssl rand -base64 24

# --- PostgreSQL (superuser, migrations and development only) ---
POSTGRES_DB=groundtruth
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Application login roles (see ADR-0001; created by `npm run roles`) ---
# gt_api      -> gt_app       read/write gt + reference, NO osm_reference
# gt_exporter -> gt_export    read-only gt,             NO osm_reference
# gt_tiles    -> gt_tileserv  read-only osm_reference,  NO gt
GT_API_PASSWORD=
GT_EXPORT_PASSWORD=
GT_TILESERV_PASSWORD=

# --- Connection strings used by tests and tooling ---
DATABASE_URL=postgres://groundtruth:PASSWORD@localhost:5432/groundtruth
GT_EXPORT_DATABASE_URL=postgres://gt_exporter:PASSWORD@localhost:5432/groundtruth

# --- Supabase (current hosted development database — see DECISIONS.md D-011) ---
#
# Use the SESSION POOLER, port 5432:
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   GT_EXPORT_DATABASE_URL=postgresql://gt_exporter.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Three things that will waste an afternoon if missed:
#
# 1. The DIRECT connection (db.<ref>.supabase.co) is IPv6-only unless the IPv4
#    add-on is purchased. On an IPv4-only network it fails with ENOTFOUND, which
#    reads like a wrong hostname rather than a missing route. Verified on this
#    project: AAAA record present, no A record.
#
# 2. The TRANSACTION pooler (port 6543) does not hold a session across statements.
#    That breaks DDL, advisory locks, and the migration table's own transaction —
#    node-pg-migrate will fail or half-apply. Session mode, port 5432, only.
#
# 3. The pooler username is "<role>.<project-ref>", not bare "<role>". A bare
#    username authenticates as the wrong tenant and fails confusingly.
#
# Dashboard settings that no migration can assert — verify by hand (RISKS.md R-010):
#   Settings -> API -> "Exposed schemas" must list none of gt, reference,
#   osm_reference; and "Automatically expose new tables" must be UNCHECKED.
#
# Before creating the project, decide the REGION — Supabase fixes it at creation and
# changing it later means migrating the database. This is a Personal Data Protection
# Act 2022 question, not a latency one: the canonical database will hold GPS traces
# of named collectors, consent references, and imagery of private premises.
#
# After creating the project, in Settings -> API:
#   - "Exposed schemas" must list ONLY what the Data API should serve. Never gt,
#     never reference, never osm_reference. See RISKS.md R-010.
#   - Uncheck "Automatically expose new tables".

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=groundtruth
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

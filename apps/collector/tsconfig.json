{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles this app, so it needs bundler resolution rather than NodeNext,
    // and emits nothing of its own. Deliberately outside the project-reference
    // graph for that reason: `tsc -b` builds libraries, Vite builds the app.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

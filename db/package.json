{
  "name": "@groundtruth/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema migrations and development seed data.",
  "scripts": {
    "_comment": "node-pg-migrate v9 dropped its dotenv dependency, so --envPath is a silent no-op. Node 24's native --env-file-if-exists loads the root .env instead, with no extra dependency.",
    "migrate": "node --env-file-if-exists=../.env ../node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations",
    "migrate:up": "node --env-file-if-exists=../.env ../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node --env-file-if-exists=../.env ../node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "migrate:check": "node --env-file-if-exists=../.env ../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations --dry-run",
    "roles": "node --env-file-if-exists=../.env scripts/create-login-roles.mjs",
    "seed": "node --env-file-if-exists=../.env scripts/seed.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
